<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy, identical to the other two apps.

  `cleartextTrafficPermitted="false"` means a misconfigured base URL fails loudly
  instead of sending a session token over plaintext. Certificate pinning is left
  commented out rather than shipped enabled: pinning a certificate the operator has
  not committed to rotating would brick every installed app the day it changes.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
