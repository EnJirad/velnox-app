<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher / splash mark.

  A vector rather than a set of PNG densities: it keeps the APK small (relevant to the
  startup-time goal), scales cleanly, and is tinted from the design system's emerald so
  the icon and the app agree. The glyph is a stylised V built from two strokes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#ECFDF5"
        android:pathData="M0,0h108v108h-108z" />

    <path
        android:fillColor="#10B981"
        android:pathData="M30,32 L54,74 L78,32 L67,32 L54,55 L41,32 Z" />

    <path
        android:fillColor="#0F172A"
        android:pathData="M47,62 L54,74 L61,62 Z" />

</vector>
