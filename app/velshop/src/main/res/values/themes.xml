<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android XML theme exists only to cover the window before Compose takes over —
  the splash background and status/navigation bar colours. All product styling lives in
  the Compose theme (core:ui/theme), so this file must not grow into a second design
  system.

  Colours match `--background: #f8fafc` so there is no flash of a different shade
  between the system window and the first composed frame.
-->
<resources>

    <style name="Theme.Velnox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/velnox_background</item>
        <item name="android:statusBarColor">@color/velnox_surface</item>
        <item name="android:navigationBarColor">@color/velnox_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
      The starting theme is swapped for Theme.Velnox by `installSplashScreen()` in
      MainActivity once the session check has run, which is what keeps the splash up
      instead of flashing the sign-in screen at a signed-in user.
    -->
    <style name="Theme.Velnox.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/velnox_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_velnox</item>
        <item name="postSplashScreenTheme">@style/Theme.Velnox</item>
    </style>

</resources>
