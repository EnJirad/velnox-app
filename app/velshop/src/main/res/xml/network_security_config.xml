<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy.

  Production traffic is HTTPS only: `cleartextTrafficPermitted="false"` means a
  misconfigured base URL fails loudly instead of silently sending a session token
  over plaintext. This is the one place the rule is enforced for the whole app — a
  per-request check would be easy to miss.

  The certificate pinning block is intentionally left commented out rather than
  shipped enabled: pinning a certificate that the operator has not committed to
  rotating would brick every installed app the day Render's certificate changes.
  Enable it only alongside a documented rotation plan (see ANDROID_BUILD.md).
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
