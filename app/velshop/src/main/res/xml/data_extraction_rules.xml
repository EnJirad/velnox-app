<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer policy.

  The session token is a 7-day bearer credential. Letting it travel to a new device
  through a cloud backup would extend the credential's reach to a device the user has
  not signed in on, which defeats the point of device-bound Keystore storage. The
  encrypted session file is therefore excluded, while harmless caches are not.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="velnox_secure_session.xml" />
        <exclude domain="sharedpref" path="velnox_secure_session" />
        <exclude domain="database" path="velnox-cache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="velnox_secure_session.xml" />
        <exclude domain="sharedpref" path="velnox_secure_session" />
    </device-transfer>
</data-extraction-rules>
