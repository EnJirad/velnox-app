# Gradle
.gradle/
build/
# (the Gradle wrapper jar is un-ignored at the bottom of this file, after `*.jar`)

# Local machine configuration (never committed)
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Android build output
*.apk
*.aab
*.ap_
*.dex
output.json
release/
captures/

# Compose / Kotlin
.kotlin/

# Logs
*.log

# Freebuff typecheck harness
node_modules/

# Compiled class file
*.class

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# …except the Gradle wrapper, which the build cannot run without.
# Order matters in .gitignore: the LAST matching pattern wins, so this negation has to
# come after the `*.jar` rule above. With it placed earlier, CI would check out a tree
# with no gradle-wrapper.jar and every `./gradlew` step would die on
# "Could not find or load main class org.gradle.wrapper.GradleWrapperMain".
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Freebuff/TypeScript incremental build state
*.tsbuildinfo

# virtual machine crash logs
hs_err_pid*
replay_pid*
