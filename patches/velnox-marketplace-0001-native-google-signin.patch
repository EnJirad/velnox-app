-/** Verify Google ID token and extract claims. */
-async function verifyGoogleIdentity(idToken: string): Promise<{
+/**
+ * A rejected Google ID token, tagged with a machine-readable code.
+ *
+ * The code travels back to the client so an Android build can tell "this token was
+ * minted for a different audience" apart from "the server is misconfigured", instead of
+ * string-matching an English message.
+ */
+class GoogleTokenError extends Error {
+  constructor(
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+    this.name = "GoogleTokenError";
+  }
+}
+
+/** The only `iss` values Google puts in an ID token. */
+const GOOGLE_ISSUERS = new Set(["accounts.google.com", "https://accounts.google.com"]);
+
+/**
+ * Verify a Google ID token and extract its claims.
+ *
+ * `tokeninfo` performs the signature check against Google's published keys, so this
+ * builds on it rather than re-implementing JWKS verification. Every claim the token
+ * *asserts* is still checked here, because a valid signature only proves Google minted
+ * it — not that it was minted for this application, for an unexpired moment, or for this
+ * particular sign-in attempt.
+ *
+ * @param expectedNonce when given, the token must carry a matching `nonce` claim.
+ */
+async function verifyGoogleIdentity(
+  idToken: string,
+  expectedNonce?: string,
+): Promise<{
   sub: string;
   email: string;
   name: string;
   picture: string;
+  nonce: string;
 }> {
   // Use Google's tokeninfo endpoint for verification
   const res = await fetch(
     `https://oauth2.googleapis.com/tokeninfo?id_token=${idToken}`
   );
   if (!res.ok) {
-    throw new Error("Invalid Google ID token");
+    // Also the path a malformed or already-expired token takes: tokeninfo answers non-200.
+    throw new GoogleTokenError("INVALID_GOOGLE_TOKEN", "Invalid Google ID token");
   }
   const claims = (await res.json()) as {
-    sub: string;
-    email: string;
-    name: string;
-    picture: string;
-    aud: string;
-    exp: string;
+    sub?: string;
+    email?: string;
+    name?: string;
+    picture?: string;
+    aud?: string;
+    iss?: string;
+    exp?: string;
+    nonce?: string;
   };
 
+  if (!claims.sub) {
+    throw new GoogleTokenError("INVALID_GOOGLE_TOKEN", "Google ID token has no subject");
+  }
+
   // Verify audience matches our client ID
   if (claims.aud !== GOOGLE_CLIENT_ID) {
-    throw new Error("Token audience mismatch");
+    throw new GoogleTokenError("GOOGLE_AUDIENCE_MISMATCH", "Token audience mismatch");
+  }
+
+  // Issuer must be Google itself.
+  if (!claims.iss || !GOOGLE_ISSUERS.has(claims.iss)) {
+    throw new GoogleTokenError("GOOGLE_ISSUER_MISMATCH", "Token issuer mismatch");
+  }
+
+  // Expiry, checked explicitly rather than inferred from tokeninfo's status code.
+  const expiresAtSeconds = Number(claims.exp);
+  if (!Number.isFinite(expiresAtSeconds) || expiresAtSeconds * 1000 <= Date.now()) {
+    throw new GoogleTokenError("GOOGLE_TOKEN_EXPIRED", "Google ID token has expired");
+  }
+
+  // Replay protection: the token must be the one minted for this attempt.
+  if (expectedNonce !== undefined && claims.nonce !== expectedNonce) {
+    throw new GoogleTokenError("GOOGLE_NONCE_MISMATCH", "Google ID token nonce mismatch");
+  }
+
+  // `resolveUser` keys on this address, so reject before touching the database.
+  if (!claims.email) {
+    throw new GoogleTokenError("INVALID_GOOGLE_TOKEN", "Google ID token has no email");
   }
 
   return {
@@ -108,6 +172,7 @@ async function verifyGoogleIdentity(idToken: string): Promise<{
     email: normalizeEmail(claims.email),
     name: claims.name || "",
     picture: claims.picture || "",
+    nonce: claims.nonce || "",
   };
 }
 
