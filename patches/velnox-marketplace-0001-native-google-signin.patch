   });
 
+  /**
+   * POST /api/auth/native/google — exchange an on-device Google ID token for a Velnox
+   * session.
+   *
+   * The Android clients cannot use the browser flow: a Custom Tab cannot hand its
+   * cookies back to the app, and an embedded WebView is both prohibited by this
+   * project's rules and blocked by Google. Credential Manager hands the app a Google ID
+   * token instead, and this endpoint accepts it.
+   *
+   * It reuses `verifyGoogleIdentity` and `resolveUser` unchanged, so identity resolution
+   * — and therefore account linking — is identical to the browser flow: one person is
+   * still one user row, matched on Google's stable `sub` first and the normalised email
+   * second. The `velnox_session` cookie is set exactly as the browser receives it, and
+   * the same JWT is returned in the body for a client that stores it itself. No second
+   * kind of credential is issued, and no token lifetime is lengthened.
+   */
+  app.post("/api/auth/native/google", async (req: Request, res: Response) => {
+    try {
+      const idToken = typeof req.body?.idToken === "string" ? req.body.idToken.trim() : "";
+      const nonce = typeof req.body?.nonce === "string" ? req.body.nonce.trim() : "";
+
+      if (!idToken || !nonce) {
+        res.status(400).json({
+          success: false,
+          error: { code: "VALIDATION_ERROR", message: "idToken and nonce are required" },
+        });
+        return;
+      }
+
+      // Signature, audience, issuer, expiry and nonce all happen inside this call.
+      const googleUser = await verifyGoogleIdentity(idToken, nonce);
+      const { userId, isNew } = await resolveUser(googleUser);
+
+      const userResult = await query(
+        `SELECT id, email, name, avatar, role, status, department, must_change_password
+         FROM users WHERE id = $1`,
+        [userId],
+      );
+      const u = userResult.rows[0];
+
+      if (!u) {
+        res.status(404).json({ success: false, error: { code: "NOT_FOUND", message: "User not found" } });
+        return;
+      }
+
+      if (u.status !== "active") {
+        res.status(403).json({
+          success: false,
+          error: { code: "ACCOUNT_DISABLED", message: "Account is disabled" },
+        });
+        return;
+      }
+
+      const sessionToken = createSessionToken(u.id, u.email);
+      // Same cookie as the browser flow, so anything server-side that reads
+      // `velnox_session` — per-user rate limiting, the WebSocket handshake — treats a
+      // native session identically instead of falling back to the anonymous budget.
+      setSessionCookie(res, sessionToken);
+
+      console.log(
+        `[auth] native google success: ${u.email} (${u.role})${isNew ? " [new user]" : ""}`,
+      );
+
+      res.json({
+        success: true,
+        data: {
+          token: sessionToken,
+          expiresInSeconds: SESSION_TTL_SECONDS,
+          user: {
+            id: u.id,
+            email: u.email,
+            name: u.name,
+            avatar: u.avatar,
+            role: u.role,
+            status: u.status,
+            department: u.department ?? null,
+            mustChangePassword: u.must_change_password === true,
+          },
+        },
+      });
+    } catch (err: any) {
+      if (err instanceof GoogleTokenError) {
+        // A rejected token is the client's problem, not a server fault.
+        console.warn(`[auth] native google rejected: ${err.code}`);
+        res.status(401).json({ success: false, error: { code: err.code, message: err.message } });
+        return;
+      }
+      console.error("[auth] native google error:", err?.message || err);
+      res.status(500).json({ success: false, error: { code: "DB_ERROR", message: "Login failed" } });
+    }
+  });
+
   // API endpoint: get current user (for frontend to check auth status)
   app.get("/api/auth/me", async (req: Request, res: Response) => {
     const token = req.cookies?.[SESSION_COOKIE];
